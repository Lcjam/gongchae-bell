# Backup environment key list for /opt/gongchae-bell/backup/backup.env (chmod 600, never commit real values).
# Kept separate from /opt/gongchae-bell/.env (DB_PASSWORD and app secrets must not be placed here).
# Defaults and descriptions live in docs/ops/backup-restore.md.

# Restic & OCI Object Storage S3-compatible Credentials
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# External Heartbeat (ADR-0006, Healthchecks.io ping URL; /fail is appended on failure)
HEALTHCHECKS_BACKUP_URL=

# Optional Overrides (defaults live in deploy/backup/backup.sh and docs/ops/backup-restore.md)
COMPOSE_FILE=
COMPOSE_ENV_FILE=
DEPLOY_STATE_DIR=
POSTGRES_SERVICE=
ERASURE_LOG_PATH=
REQUIRE_ERASURE_LOG=
BACKUP_LOCK_FILE=
BACKUP_LOCK_WAIT_SECONDS=
BACKUP_STAGE_ROOT=
BACKUP_HOST_TAG=
RESTIC_INIT_IF_MISSING=
