# Windows PC pull backup environment key list (ADR-0012, ADR-0017, #17).
# Place at %LOCALAPPDATA%\gongchae-bell\backup-env\pc-pull.env with restricted ACL
# (current user, SYSTEM, Administrators only; remove inheritance / CodexSandboxUsers).
# Never commit real values, keys, passwords, or Healthchecks URLs.
# See docs/ops/pc-pull-backup.md for setup, ACL, and Task Scheduler instructions.

# Local PC Destination Repository (must be a local NTFS path outside Git/OneDrive/Google Drive)
# Default if empty: %LOCALAPPDATA%\gongchae-bell\backup-replica
PC_RESTIC_REPOSITORY=
# Recommended: store local repo password in a separate ACL-restricted file (e.g. %LOCALAPPDATA%\gongchae-bell\backup-env\pc-repo.pass)
# Separate from OCI_RESTIC_PASSWORD. Do not set both PC_RESTIC_PASSWORD_FILE and PC_RESTIC_PASSWORD.
PC_RESTIC_PASSWORD_FILE=
PC_RESTIC_PASSWORD=

# Remote OCI Source Repository (read-only IAM principal ONLY: inspect buckets + read objects; NEVER reuse admin key)
OCI_RESTIC_REPOSITORY=
# Recommended: store OCI source repo password in a separate ACL-restricted file (e.g. %LOCALAPPDATA%\gongchae-bell\backup-env\oci-repo.pass)
# Do not set both OCI_RESTIC_PASSWORD_FILE and OCI_RESTIC_PASSWORD.
OCI_RESTIC_PASSWORD_FILE=
OCI_RESTIC_PASSWORD=
OCI_AWS_ACCESS_KEY_ID=
OCI_AWS_SECRET_ACCESS_KEY=
OCI_AWS_DEFAULT_REGION=

# External Heartbeat (ADR-0006, separate Healthchecks.io ping URL from OCI server backup; /fail appended on failure)
HEALTHCHECKS_PC_PULL_URL=

# Optional Overrides (defaults live in deploy/backup/pc/pc-pull.ps1 and docs/ops/pc-pull-backup.md)
PC_LOCK_FILE=
PC_CACHE_DIR=
PC_LOG_DIR=
RESTIC_BIN=
PYTHON_BIN=
EXPIRE_SELECT_PATH=
COPY_MAX_RETRIES=
COPY_RETRY_DELAY_SECONDS=
PC_CHECK_ACL=
