(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(token_page_headers) {
	header /subscriptions* {
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
		X-Robots-Tag "noindex"
	}
}

import /etc/caddy/runtime/upstream.caddy

{$SITE_DOMAIN:gongchae.enjoylcjworld.com} {
	import security_headers
	import token_page_headers

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete t
				}
				request>raw_uri query {
					delete t
				}
				request>headers>Referer delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	import active_upstream
}
