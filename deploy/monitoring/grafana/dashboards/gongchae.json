{
  "uid": "gongchae-ops",
  "title": "공채벨 운영",
  "tags": [
    "gongchae"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "웹 (HTTP는 색별 rate의 sum, actuator 제외)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 (경로 템플릿별, 5분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"gongchae-app\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{uri}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "버킷 5ms~10s 기준 근사값. 목표는 기준선 실측 후 정한다(PRD §6)."
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx 비율 (5분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"gongchae-app\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"gongchae-app\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "5xx 비율",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "경보 GongchaeHttp5xxHigh: 10분 5% 초과이면서 5건 이상, 5분 지속."
    },
    {
      "type": "timeseries",
      "title": "HTTP 요청률 (상태별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"gongchae-app\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "bargauge",
      "title": "화면 요청 (선택 기간 합, page·traffic)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (page, traffic) (increase(gongchae_page_views_total{job=\"gongchae-app\"}[$__range]))",
          "legendFormat": "{{page}} · {{traffic}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "description": "traffic=user만 방문으로 본다. bot·internal(UptimeRobot 등)은 분리. increase()는 근사이고, 앱 종료 직전 마지막 scrape 뒤 증가분(최대 30초)은 잃는다."
    },
    {
      "type": "bargauge",
      "title": "원문 이동 (선택 기간 합)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (generic, traffic) (increase(gongchae_source_redirects_total{job=\"gongchae-app\"}[$__range]))",
          "legendFormat": "generic={{generic}} · {{traffic}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      }
    },
    {
      "type": "timeseries",
      "title": "앱 scrape 상태 (색별)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"gongchae-app\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "실행 중인 색만 1이다. 둘 다 0이 5분 이어지면 GongchaeAppMetricsDown."
    },
    {
      "type": "row",
      "title": "정기 수집 (DB 기반 게이지: 두 색 같은 값 → max)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "마지막 완전 수집 경과",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(collector_last_complete_epoch{job=\"gongchae-app\"}) and max(collector_last_complete_epoch{job=\"gongchae-app\"}) > 0",
          "legendFormat": "경과",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4500
              },
              {
                "color": "red",
                "value": 8100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "완전 수집 기록이 없으면 No data로 둔다(0으로 채우지 않음). 8100초(2시간 15분) 초과 시 GongchaeRegularCollectionStale."
    },
    {
      "type": "stat",
      "title": "최근 완전 수집 뒤 미완료 회차",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_regular_incomplete_consecutive{job=\"gongchae-app\"})",
          "legendFormat": "미완료",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "진행 중 회차 포함. 2 이상이 10분 이어지면 GongchaeRegularCollectionFailing."
    },
    {
      "type": "stat",
      "title": "최근 24시간 선점 / 완료 (예정 24)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_regular_claimed_last24h{job=\"gongchae-app\"})",
          "legendFormat": "선점",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_regular_complete_last24h{job=\"gongchae-app\"})",
          "legendFormat": "완료",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "미종료 회차 / 상세 포기 공고",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_runs_unfinished{job=\"gongchae-app\"})",
          "legendFormat": "미종료 회차",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_detail_gave_up{job=\"gongchae-app\"})",
          "legendFormat": "상세 포기",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "미종료: 진행 중이거나 종료 중 끊긴 회차. 상세 포기: 실패 3회 상한에 걸린 진행 공고(docs/ops/collector.md)."
    },
    {
      "type": "row",
      "title": "공공데이터 API 일 예산 (KST, 두 색 같은 값 → max)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "오늘 호출 / 경고·차단 한도",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_api_attempts_today{job=\"gongchae-app\"})",
          "legendFormat": "오늘 호출",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_api_warning_limit{job=\"gongchae-app\"})",
          "legendFormat": "경고 한도",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_api_stop_limit{job=\"gongchae-app\"})",
          "legendFormat": "차단 한도",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "경고 한도 이상 GongchaeApiBudgetWarning, 차단 한도 이상 GongchaeApiBudgetStopped. 상세·최초 적재는 차단 한도-72에서 먼저 멈춘다(ADR-0014)."
    },
    {
      "type": "timeseries",
      "title": "종류별 / 재시도 / 결과 없는 예약",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (kind) (collector_api_attempts_kind_today{job=\"gongchae-app\"})",
          "legendFormat": "{{kind}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_api_retries_today{job=\"gongchae-app\"})",
          "legendFormat": "재시도",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(collector_api_unfinished_today{job=\"gongchae-app\"})",
          "legendFormat": "결과 없음",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "경보와 발송",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Prometheus 경보 (firing)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Grafana가 이 목록을 운영 디스코드로 전달한다(provisioning/alerting/forward.yml).",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        }
      ]
    },
    {
      "type": "text",
      "title": "발송 적체·실패·결과 불명확 (M2)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "options": {
        "mode": "markdown",
        "content": "**아직 지표가 없다.** 발송기(#7)가 구현·머지되면 `docs/ops/monitoring.md`의 M2 통합 계약대로 지표와 경보를 붙인다. 지표가 없는 동안 0으로 채워 정상처럼 보이게 하지 않는다."
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
